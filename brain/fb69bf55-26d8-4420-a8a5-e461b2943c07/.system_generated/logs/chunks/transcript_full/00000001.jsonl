{"step_index":81,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-07T10:38:40Z","thinking":"**Initiating Network Graph Component Creation**\n\nThe focus shifts towards building a crucial `NetworkGraphContainer.tsx` component. This component will be reusable, forming the foundation for the \"Network Analysis\" page. A rich, interactive Canvas/SVG Network Graph visualization is the target, incorporating pan, zoom (wheel and buttons), node dragging, and node selection with an inspector panel.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import React, { useState, useRef, useEffect, useMemo } from 'react'\nimport { useNavigate } from 'react-router-dom'\nimport { \n  ZoomIn, \n  ZoomOut, \n  RotateCcw, \n  Filter, \n  Layers, \n  User, \n  Building2, \n  Smartphone, \n  Landmark, \n  Home, \n  Truck, \n  ShieldAlert, \n  ExternalLink,\n  SlidersHorizontal,\n  X\n} from 'lucide-react'\nimport { NetworkGraphData, GraphNode, GraphEdge, EntityType } from '../../types'\nimport { Button } from '../ui/button'\nimport { Badge } from '../ui/badge'\nimport { Card } from '../ui/card'\nimport { cn } from '../../lib/utils'\n\ninterface NetworkGraphContainerProps {\n  initialData: NetworkGraphData\n  height?: string\n  onNodeClick?: (node: GraphNode) => void\n  interactive?: boolean\n}\n\nexport const NetworkGraphContainer: React.FC<NetworkGraphContainerProps> = ({\n  initialData,\n  height = 'h-[620px]',\n  onNodeClick,\n  interactive = true,\n}) => {\n  const navigate = useNavigate()\n  const containerRef = useRef<HTMLDivElement>(null)\n\n  // Viewport State\n  const [zoom, setZoom] = useState(1)\n  const [pan, setPan] = useState({ x: 0, y: 0 })\n  const [isDraggingCanvas, setIsDraggingCanvas] = useState(false)\n  const [dragStart, setDragStart] = useState({ x: 0, y: 0 })\n\n  // Selection & Hover\n  const [selectedNode, setSelectedNode] = useState<GraphNode | null>(null)\n  const [hoveredNode, setHoveredNode] = useState<GraphNode | null>(null)\n\n  // Filters\n  const [minRiskScore, setMinRiskScore] = useState(0)\n  const [selectedTypes, setSelectedTypes] = useState<EntityType[]>([\n    'suspect', 'shell_company', 'burner_phone', 'bank_account', 'safehouse', 'vehicle', 'organization'\n  ])\n  const [showOnlySuspiciousEdges, setShowOnlySuspiciousEdges] = useState(false)\n  const [showFilterDrawer, setShowFilterDrawer] = useState(false)\n\n  // Filtered Nodes and Edges\n  const filteredNodes = useMemo(() => {\n    return initialData.nodes.filter(\n      (node) => node.riskScore >= minRiskScore && selectedTypes.includes(node.type)\n    )\n  }, [initialData.nodes, minRiskScore, selectedTypes])\n\n  const filteredNodeIds = useMemo(() => new Set(filteredNodes.map(n => n.id)), [filteredNodes])\n\n  const filteredEdges = useMemo(() => {\n    return initialData.edges.filter((edge) => {\n      const hasBothNodes = filteredNodeIds.has(edge.source) && filteredNodeIds.has(edge.target)\n      if (!hasBothNodes) return false\n      if (showOnlySuspiciousEdges && !edge.isSuspicious) return false\n      return true\n    })\n  }, [initialData.edges, filteredNodeIds, showOnlySuspiciousEdges])\n\n  // Mouse wheel zoom\n  const handleWheel = (e: React.WheelEvent) => {\n    e.preventDefault()\n    const zoomFactor = e.deltaY < 0 ? 1.1 : 0.9\n    setZoom((prev) => Math.min(Math.max(prev * zoomFactor, 0.4), 2.5))\n  }\n\n  // Pan handlers\n  const handleMouseDown = (e: React.MouseEvent) => {\n    if (e.button !== 0) return // Only primary button\n    setIsDraggingCanvas(true)\n    setDragStart({ x: e.clientX - pan.x, y: e.clientY - pan.y })\n  }\n\n  const handleMouseMove = (e: React.MouseEvent) => {\n    if (isDraggingCanvas) {\n      setPan({\n        x: e.clientX - dragStart.x,\n        y: e.clientY - dragStart.y,\n      })\n    }\n  }\n\n  const handleMouseUp = () => {\n    setIsDraggingCanvas(false)\n  }\n\n  const handleResetView = () => {\n    setZoom(1)\n    setPan({ x: 0, y: 0 })\n  }\n\n  const toggleTypeFilter = (type: EntityType) => {\n    setSelectedTypes(prev => \n      prev.includes(type) ? prev.filter(t => t !== type) : [...prev, type]\n    )\n  }\n\n  // Helper icons and colors by entity type\n  const getTypeMeta = (type: EntityType) => {\n    switch (type) {\n      case 'suspect':\n        return { color: '#ef4444', label: 'Suspect', icon: User, stroke: 'rgba(239, 68, 68, 0.4)' }\n      case 'shell_company':\n        return { color: '#f59e0b', label: 'Shell Corp', icon: Building2, stroke: 'rgba(245, 158, 11, 0.4)' }\n      case 'burner_phone':\n        return { color: '#00e5ff', label: 'Burner Phone', icon: Smartphone, stroke: 'rgba(0, 229, 255, 0.4)' }\n      case 'bank_account':\n        return { color: '#10b981', label: 'Bank Account', icon: Landmark, stroke: 'rgba(16, 185, 129, 0.4)' }\n      case 'safehouse':\n        return { color: '#a855f7', label: 'Safehouse', icon: Home, stroke: 'rgba(168, 85, 247, 0.4)' }\n      case 'vehicle':\n        return { color: '#38bdf8', label: 'Vehicle', icon: Truck, stroke: 'rgba(56, 189, 248, 0.4)' }\n      default:\n        return { color: '#94a3b8', label: 'Entity', icon: User, stroke: 'rgba(148, 163, 184, 0.4)' }\n    }\n  }\n\n  // Find node coordinates map\n  const nodeMap = useMemo(() => {\n    const map = new Map<string, GraphNode>()\n    filteredNodes.forEach(n => map.set(n.id, n))\n    return map\n  }, [filteredNodes])\n\n  return (\n    <div className={cn('relative w-full rounded-sm border border-slate-800 bg-[#090d16] overflow-hidden select-none', height)}>\n      {/* Background Tactical Grid & Radar Concentrics */}\n      <div className=\"absolute inset-0 pointer-events-none tactical-grid opacity-60\" />\n      <svg className=\"absolute inset-0 w-full h-full pointer-events-none opacity-20\">\n        <circle cx=\"50%\" cy=\"50%\" r=\"150\" fill=\"none\" stroke=\"#00e5ff\" strokeWidth=\"1\" strokeDasharray=\"4 4\" />\n        <circle cx=\"50%\" cy=\"50%\" r=\"300\" fill=\"none\" stroke=\"#00e5ff\" strokeWidth=\"1\" strokeDasharray=\"4 4\" />\n        <circle cx=\"50%\" cy=\"50%\" r=\"450\" fill=\"none\" stroke=\"#00e5ff\" strokeWidth=\"1\" strokeDasharray=\"4 4\" />\n        <line x1=\"50%\" y1=\"0\" x2=\"50%\" y2=\"100%\" stroke=\"#00e5ff\" strokeWidth=\"0.5\" strokeDasharray=\"2 2\" />\n        <line x1=\"0\" y1=\"50%\" x2=\"100%\" y2=\"50%\" stroke=\"#00e5ff\" strokeWidth=\"0.5\" strokeDasharray=\"2 2\" />\n      </svg>\n\n      {/* Top Left Toolbar */}\n      <div className=\"absolute left-3 top-3 z-10 flex items-center space-x-2\">\n        <div className=\"flex items-center space-x-1 rounded-sm border border-slate-800 bg-[#0c121e]/90 p-1 backdrop-blur-md\">\n          <Button variant=\"ghost\" size=\"sm\" onClick={() => setZoom(z => Math.min(z * 1.2, 2.5))} title=\"Zoom In\">\n            <ZoomIn className=\"h-3.5 w-3.5\" />\n          </Button>\n          <Button variant=\"ghost\" size=\"sm\" onClick={() => setZoom(z => Math.max(z / 1.2, 0.4))} title=\"Zoom Out\">\n            <ZoomOut className=\"h-3.5 w-3.5\" />\n          </Button>\n          <Button variant=\"ghost\" size=\"sm\" onClick={handleResetView} title=\"Reset Center\">\n            <RotateCcw className=\"h-3.5 w-3.5\" />\n          </Button>\n          <div className=\"h-4 w-px bg-slate-800 mx-1\" />\n          <span className=\"font-mono text-[10px] text-cyan-400 px-2\">\n            {Math.round(zoom * 100)}%\n          </span>\n        </div>\n\n        <Button\n          variant={showFilterDrawer ? 'cyan' : 'tactical'}\n          size=\"sm\"\n          onClick={() => setShowFilterDrawer(!showFilterDrawer)}\n          className=\"flex items-center space-x-1.5\"\n        >\n          <Filter className=\"h-3.5 w-3.5\" />\n          <span>Filters ({filteredNodes.length}/{initialData.nodes.length})</span>\n        </Button>\n      </div>\n\n      {/* Top Right Intelligence Telemetry */}\n      <div className=\"absolute right-3 top-3 z-10 flex items-center space-x-2\">\n        <div className=\"hidden sm:flex items-center space-x-2 rounded-sm border border-slate-800 bg-[#0c121e]/90 px-3 py-1.5 font-mono text-[10px] text-slate-400 backdrop-blur-md\">\n          <span className=\"flex items-center space-x-1\">\n            <span className=\"h-2 w-2 rounded-full bg-cyan-400 animate-pulse\" />\n            <span className=\"text-cyan-300 font-semibold\">SYNAPSE TOPOLOGY ENGINE</span>\n          </span>\n          <span>•</span>\n          <span>NODES: <span className=\"text-slate-200\">{filteredNodes.length}</span></span>\n          <span>•</span>\n          <span>EDGES: <span className=\"text-slate-200\">{filteredEdges.length}</span></span>\n        </div>\n      </div>\n\n      {/* Filter Drawer Overlay */}\n      {showFilterDrawer && (\n        <div className=\"absolute left-3 top-14 z-20 w-72 rounded-sm border border-slate-700 bg-[#0c121e]/95 p-4 shadow-2xl backdrop-blur-md font-mono text-xs\">\n          <div className=\"flex items-center justify-between border-b border-slate-800 pb-2 mb-3\">\n            <span className=\"font-bold text-cyan-400 flex items-center gap-1.5\">\n              <SlidersHorizontal className=\"h-3.5 w-3.5\" />\n              TOPOLOGY FILTERS\n            </span>\n            <button onClick={() => setShowFilterDrawer(false)} className=\"text-slate-400 hover:text-white\">\n              <X className=\"h-3.5 w-3.5\" />\n            </button>\n          </div>\n\n          <div className=\"space-y-4\">\n            {/* Risk Threshold */}\n            <div>\n              <div className=\"flex justify-between text-[11px] text-slate-300 mb-1\">\n                <span>Threat Risk Threshold</span>\n                <span className=\"text-cyan-400 font-bold\">{minRiskScore}+</span>\n              </div>\n              <input\n                type=\"range\"\n                min=\"0\"\n                max=\"95\"\n                step=\"5\"\n                value={minRiskScore}\n                onChange={(e) => setMinRiskScore(Number(e.target.value))}\n                className=\"w-full h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-cyan-400\"\n              />\n            </div>\n\n            {/* Entity Types */}\n            <div>\n              <div className=\"text-[11px] text-slate-300 mb-2 font-semibold\">Entity Classes</div>\n              <div className=\"grid grid-cols-2 gap-1.5\">\n                {(['suspect', 'shell_company', 'burner_phone', 'bank_account', 'safehouse', 'vehicle'] as EntityType[]).map((type) => {\n                  const meta = getTypeMeta(type)\n                  const isChecked = selectedTypes.includes(type)\n                  return (\n                    <button\n                      key={type}\n                      onClick={() => toggleTypeFilter(type)}\n                      className={cn(\n                        'flex items-center space-x-1.5 px-2 py-1 rounded-xs border text-[10px] text-left transition-colors',\n                        isChecked \n                          ? 'border-cyan-500/50 bg-cyan-950/40 text-cyan-200' \n                          : 'border-slate-800 bg-slate-900/60 text-slate-400 opacity-60'\n                      )}\n                    >\n                      <meta.icon className=\"h-3 w-3\" style={{ color: meta.color }} />\n                      <span className=\"truncate\">{meta.label}</span>\n                    </button>\n                  )\n                })}\n              </div>\n            </div>\n\n            {/* Suspicious Only */}\n            <label className=\"flex items-center space-x-2 text-[11px] text-slate-300 cursor-pointer pt-1 border-t border-slate-800\">\n              <input\n                type=\"checkbox\"\n                checked={showOnlySuspiciousEdges}\n                onChange={(e) => setShowOnlySuspiciousEdges(e.target.checked)}\n                className=\"rounded-xs border-slate-700 bg-slate-900 text-cyan-500 focus:ring-0\"\n              />\n              <span>Highlight Suspicious Transfers Only</span>\n            </label>\n          </div>\n        </div>\n      )}\n\n      {/* Main Interactive SVG Canvas */}\n      <div\n        ref={containerRef}\n        onWheel={handleWheel}\n        onMouseDown={handleMouseDown}\n        onMouseMove={handleMouseMove}\n        onMouseUp={handleMouseUp}\n        className=\"w-full h-full cursor-grab active:cursor-grabbing\"\n      >\n        <svg className=\"w-full h-full overflow-visible\">\n          <g transform={`translate(${pan.x + 80}, ${pan.y + 40}) scale(${zoom})`}>\n            {/* Edges */}\n            {filteredEdges.map((edge) => {\n              const src = nodeMap.get(edge.source)\n              const tgt = nodeMap.get(edge.target)\n              if (!src || !tgt || src.x === undefined || src.y === undefined || tgt.x === undefined || tgt.y === undefined) return null\n\n              const isHighlighted = \n                selectedNode && (selectedNode.id === edge.source || selectedNode.id === edge.target)\n\n              const isWire = edge.relationship === 'wire_transfer'\n              const strokeColor = isHighlighted \n                ? '#00e5ff' \n                : isWire \n                ? '#10b981' \n                : edge.isSuspicious \n                ? '#ef4444' \n                : '#475e82'\n\n              const midX = (src.x + tgt.x) / 2\n              const midY = (src.y + tgt.y) / 2\n\n              return (\n                <g key={edge.id}>\n                  {/* Glowing line for active connections */}\n                  {isHighlighted && (\n                    <line\n                      x1={src.x}\n                      y1={src.y}\n                      x2={tgt.x}\n                      y2={tgt.y}\n                      stroke=\"#00e5ff\"\n                      strokeWidth=\"4\"\n                      strokeOpacity=\"0.4\"\n                    />\n                  )}\n                  <line\n                    x1={src.x}\n                    y1={src.y}\n                    x2={tgt.x}\n                    y2={tgt.y}\n                    stroke={strokeColor}\n                    strokeWidth={isHighlighted ? 2.5 : Math.max(edge.weight / 4, 1.2)}\n                    strokeDasharray={edge.relationship === 'encrypted_call' ? '4 4' : undefined}\n                    strokeOpacity={isHighlighted ? 1 : 0.75}\n                  />\n\n                  {/* Edge Label Pill */}\n                  {(zoom > 0.75 || isHighlighted) && (\n                    <g transform={`translate(${midX}, ${midY})`}>\n                      <rect\n                        x=\"-45\"\n                        y=\"-8\"\n                        width=\"90\"\n                        height=\"16\"\n                        rx=\"2\"\n                        fill=\"#0c121e\"\n                        stroke={strokeColor}\n                        strokeWidth=\"0.8\"\n                        fillOpacity=\"0.9\"\n                      />\n                      <text\n                        textAnchor=\"middle\"\n                        y=\"3.5\"\n                        fill=\"#cbd5e1\"\n                        fontSize=\"7.5\"\n                        fontFamily=\"monospace\"\n                        fontWeight=\"600\"\n                      >\n                        {edge.amount || edge.label.slice(0, 15)}\n                      </text>\n                    </g>\n                  )}\n                </g>\n              )\n            })}\n\n            {/* Nodes */}\n            {filteredNodes.map((node) => {\n              if (node.x === undefined || node.y === undefined) return null\n\n              const meta = getTypeMeta(node.type)\n              const isSelected = selectedNode?.id === node.id\n              const isHovered = hoveredNode?.id === node.id\n              const nodeRadius = node.isHVT ? 26 : 20\n\n              return (\n                <g\n                  key={node.id}\n                  transform={`translate(${node.x}, ${node.y})`}\n                  className=\"cursor-pointer transition-transform\"\n                  onClick={(e) => {\n                    e.stopPropagation()\n                    setSelectedNode(node)\n                    if (onNodeClick) onNodeClick(node)\n                  }}\n                  onMouseEnter={() => setHoveredNode(node)}\n                  onMouseLeave={() => setHoveredNode(null)}\n                >\n                  {/* Outer Radar Glow on Selected / HVT */}\n                  {(isSelected || node.isHVT) && (\n                    <circle\n                      r={nodeRadius + 8}\n                      fill=\"none\"\n                      stroke={meta.color}\n                      strokeWidth=\"1.5\"\n                      strokeDasharray=\"3 3\"\n                      className=\"animate-spin-slow\"\n                      opacity=\"0.8\"\n                    />\n                  )}\n\n                  {/* Base Circle */}\n                  <circle\n                    r={nodeRadius}\n                    fill=\"#0a0f1d\"\n                    stroke={isSelected ? '#00e5ff' : meta.color}\n                    strokeWidth={isSelected ? 3 : 2}\n                  />\n\n                  {/* Threat Risk Pill Badge at top of node */}\n                  <g transform={`translate(0, -${nodeRadius + 4})`}>\n                    <rect\n                      x=\"-14\"\n                      y=\"-7\"\n                      width=\"28\"\n                      height=\"12\"\n                      rx=\"2\"\n                      fill={node.riskScore >= 90 ? '#ef4444' : node.riskScore >= 75 ? '#f59e0b' : '#00e5ff'}\n                    />\n                    <text\n                      textAnchor=\"middle\"\n                      y=\"2\"\n                      fill=\"#000000\"\n                      fontSize=\"7\"\n                      fontWeight=\"bold\"\n                      fontFamily=\"monospace\"\n                    >\n                      {node.riskScore}\n                    </text>\n                  </g>\n\n                  {/* Center Symbol / Icon Text */}\n                  <text\n                    textAnchor=\"middle\"\n                    y=\"4\"\n                    fill={meta.color}\n                    fontSize={node.isHVT ? \"12\" : \"10\"}\n                    fontWeight=\"bold\"\n                    fontFamily=\"monospace\"\n                  >\n                    {node.type === 'suspect' ? 'SUS' : \n                     node.type === 'shell_company' ? 'CORP' : \n                     node.type === 'burner_phone' ? 'SIG' : \n                     node.type === 'bank_account' ? 'IBAN' : \n                     node.type === 'safehouse' ? 'SAFE' : 'VEH'}\n                  </text>\n\n                  {/* Label Text below node */}\n                  <text\n                    textAnchor=\"middle\"\n                    y={nodeRadius + 14}\n                    fill={isSelected ? '#00e5ff' : '#f1f5f9'}\n                    fontSize=\"9.5\"\n                    fontFamily=\"monospace\"\n                    fontWeight=\"600\"\n                    className=\"select-none filter drop-shadow-[0_2px_4px_rgba(0,0,0,0.9)]\"\n                  >\n                    {node.label.length > 20 ? node.label.slice(0, 18) + '...' : node.label}\n                  </text>\n                </g>\n              )\n            })}\n          </g>\n        </svg>\n      </div>\n\n      {/* Selected Node Intelligence Inspector Panel (Right Drawer) */}\n      {selectedNode && (\n        <div className=\"absolute right-3 bottom-3 top-14 z-20 w-84 rounded-sm border border-cyan-500/50 bg-[#0c121e]/95 p-4 shadow-2xl backdrop-blur-lg font-mono text-xs animate-in slide-in-from-right duration-150 overflow-y-auto\">\n          <div className=\"flex items-center justify-between border-b border-slate-800 pb-2 mb-3\">\n            <div className=\"flex items-center space-x-2\">\n              <span className=\"h-2 w-2 rounded-full bg-cyan-400\" />\n              <span className=\"font-bold text-cyan-400 tracking-wider\">TARGET DOSSIER TELEMETRY</span>\n            </div>\n            <button \n              onClick={() => setSelectedNode(null)}\n              className=\"rounded-xs p-1 text-slate-400 hover:text-white hover:bg-slate-800\"\n            >\n              <X className=\"h-3.5 w-3.5\" />\n            </button>\n          </div>\n\n          <div className=\"space-y-3\">\n            {/* Header info */}\n            <div>\n              <div className=\"flex items-center justify-between\">\n                <Badge variant={selectedNode.riskScore >= 90 ? 'critical' : 'high'}>\n                  RISK INDEX {selectedNode.riskScore}/100\n                </Badge>\n                <span className=\"text-[10px] text-slate-400 uppercase\">{selectedNode.type}</span>\n              </div>\n              <h3 className=\"mt-1.5 text-sm font-bold text-slate-100\">{selectedNode.label}</h3>\n              <p className=\"text-[10px] text-cyan-300\">Cluster: {selectedNode.cluster} Division</p>\n            </div>\n\n            {/* Metrics grid */}\n            <div className=\"grid grid-cols-2 gap-2 border-y border-slate-800 py-2.5 text-[10px]\">\n              <div>\n                <span className=\"text-slate-400\">Node Degree:</span>\n                <span className=\"ml-1 text-slate-200 font-bold\">{selectedNode.degree} links</span>\n              </div>\n              <div>\n                <span className=\"text-slate-400\">Betweenness:</span>\n                <span className=\"ml-1 text-slate-200 font-bold\">{selectedNode.betweenness}</span>\n              </div>\n              <div>\n                <span className=\"text-slate-400\">Legal Status:</span>\n                <span className=\"ml-1 text-amber-400 font-bold\">{selectedNode.status}</span>\n              </div>\n              <div>\n                <span className=\"text-slate-400\">Classification:</span>\n                <span className=\"ml-1 text-red-400 font-bold\">{selectedNode.isHVT ? 'HVT TIER-1' : 'TIER-2'}</span>\n              </div>\n            </div>\n\n            {/* Connected Relationships */}\n            <div>\n              <div className=\"text-[10px] uppercase tracking-wider text-slate-400 font-semibold mb-1.5\">\n                Active Direct Vectors ({initialData.edges.filter(e => e.source === selectedNode.id || e.target === selectedNode.id).length})\n              </div>\n              <div className=\"space-y-1 max-h-32 overflow-y-auto\">\n                {initialData.edges\n                  .filter(e => e.source === selectedNode.id || e.target === selectedNode.id)\n                  .map(edge => {\n                    const peerId = edge.source === selectedNode.id ? edge.target : edge.source\n                    const peer = initialData.nodes.find(n => n.id === peerId)\n                    return (\n                      <div key={edge.id} className=\"p-1.5 rounded-xs bg-slate-900/90 border border-slate-800 text-[10px] flex items-center justify-between\">\n                        <div>\n                          <div className=\"text-slate-200 font-semibold truncate w-40\">{peer?.label}</div>\n                          <div className=\"text-slate-400 text-[9px]\">{edge.label}</div>\n                        </div>\n                        {edge.amount && (\n                          <span className=\"text-emerald-400 font-bold\">{edge.amount}</span>\n                        )}\n                      </div>\n                    )\n                  })}\n              </div>\n            </div>\n\n            {/* Drill Down Action */}\n            <div className=\"pt-2\">\n              <Button\n                variant=\"cyan\"\n                size=\"sm\"\n                className=\"w-full flex items-center justify-center space-x-1\"\n                onClick={() => {\n                  if (selectedNode.type === 'suspect' || selectedNode.id.startsWith('ent-')) {\n                    navigate(`/entity/${selectedNode.id}`)\n                  } else {\n                    navigate(`/cases`)\n                  }\n                }}\n              >\n                <span>Open Complete Dossier</span>\n                <ExternalLink className=\"h-3 w-3 ml-1\" />\n              </Button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Legend Footer */}\n      <div className=\"absolute left-3 bottom-3 z-10 hidden md:flex items-center space-x-3 rounded-sm border border-slate-800/80 bg-[#0c121e]/90 px-3 py-1.5 font-mono text-[9px] text-slate-400 backdrop-blur-md\">\n        <span className=\"font-semibold text-slate-300 uppercase\">Legend:</span>\n        <span className=\"flex items-center space-x-1\">\n          <span className=\"h-2 w-2 rounded-full bg-red-500\" />\n          <span>Suspect</span>\n        </span>\n        <span className=\"flex items-center space-x-1\">\n          <span className=\"h-2 w-2 rounded-full bg-amber-500\" />\n          <span>Shell Company</span>\n        </span>\n        <span className=\"flex items-center space-x-1\">\n          <span className=\"h-2 w-2 rounded-full bg-cyan-400\" />\n          <span>Burner SIGINT</span>\n        </span>\n        <span className=\"flex items-center space-x-1\">\n          <span className=\"h-2 w-2 rounded-full bg-emerald-500\" />\n          <span>Financial / Wire</span>\n        </span>\n        <span className=\"flex items-center space-x-1\">\n          <span className=\"h-2 w-2 rounded-full bg-purple-500\" />\n          <span>Safehouse</span>\n        </span>\n      </div>\n    </div>\n  )\n}\n","Description":"Create interactive NetworkGraphContainer with canvas pan, zoom, node inspector, and threat filtering","Overwrite":true,"TargetFile":"C:\\Users\\Nityam Jaiswal\\.gemini\\antigravity\\scratch\\nexus\\src\\components\\network\\NetworkGraphContainer.tsx","toolAction":"Creating network/NetworkGraphContainer.tsx","toolSummary":"Create NetworkGraphContainer component"}}]}
