{"step_index":95,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-07T10:39:55Z","thinking":"**Designing Evidence Upload Page**\n\nConstructing a new page focused on evidence upload and ingestion. The design must accommodate diverse file formats, including call detail records, financial ledgers, audio, video, and forensic images. Implementing a drag-and-drop file selector is essential for an intuitive user experience, alongside SHA-256 hash generation for data integrity. Also incorporating chain-of-custody logging fields (Officer Name, Badge ID, Seizure Location, Assigned) to track data provenance.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import React, { useState } from 'react'\nimport { \n  UploadCloud, \n  FileCheck, \n  ShieldCheck, \n  Fingerprint, \n  Cpu, \n  Database, \n  Headphones, \n  Video, \n  FileText, \n  AlertCircle, \n  CheckCircle2,\n  RefreshCw,\n  Hash\n} from 'lucide-react'\nimport { mockEvidence, mockCases } from '../data/mockData'\nimport { Evidence, EvidenceType, ClassificationLevel } from '../types'\nimport { EvidenceCard } from '../components/common/EvidenceCard'\nimport { Card, CardHeader, CardTitle, CardContent } from '../components/ui/card'\nimport { Button } from '../components/ui/button'\nimport { Input } from '../components/ui/input'\nimport { Badge } from '../components/ui/badge'\n\nexport const UploadEvidencePage: React.FC = () => {\n  const [evidenceList, setEvidenceList] = useState<Evidence[]>(mockEvidence)\n  const [selectedCaseId, setSelectedCaseId] = useState('case-1')\n  const [evidenceType, setEvidenceType] = useState<EvidenceType>('wiretap')\n  const [classification, setClassification] = useState<ClassificationLevel>('TOP SECRET // SI')\n  const [title, setTitle] = useState('')\n  const [custodyOfficer, setCustodyOfficer] = useState('Special Agent Sarah Vance')\n  const [badgeNumber, setBadgeNumber] = useState('FED-8491')\n  const [location, setLocation] = useState('Sector 4 Intercept Station, Constanta')\n  const [selectedFile, setSelectedFile] = useState<File | null>(null)\n  \n  // Pipeline Processing Simulation State\n  const [isProcessing, setIsProcessing] = useState(false)\n  const [pipelineStep, setPipelineStep] = useState(0)\n  const [generatedHash, setGeneratedHash] = useState('')\n\n  const handleSimulateFileSelect = (name: string, type: EvidenceType) => {\n    setSelectedFile(new File(['dummy-content'], name, { type: 'text/plain' }))\n    setEvidenceType(type)\n    setTitle(`Automated Intercept Capture - ${name}`)\n  }\n\n  const handleProcessUpload = (e: React.FormEvent) => {\n    e.preventDefault()\n    setIsProcessing(true)\n    setPipelineStep(1)\n\n    // Simulate Step 1: Hashing\n    setTimeout(() => {\n      const mockHash = Array.from({ length: 64 }, () => Math.floor(Math.random() * 16).toString(16)).join('')\n      setGeneratedHash(mockHash)\n      setPipelineStep(2)\n\n      // Step 2: NER Extraction\n      setTimeout(() => {\n        setPipelineStep(3)\n\n        // Step 3: Biometrics & Synthesis\n        setTimeout(() => {\n          setPipelineStep(4)\n\n          // Step 4: Finalize\n          setTimeout(() => {\n            const chosenCase = mockCases.find(c => c.id === selectedCaseId)\n            const newEv: Evidence = {\n              id: `ev-${Date.now()}`,\n              evidenceNumber: `EV-${Math.floor(1000 + Math.random() * 9000)}-${evidenceType.slice(0, 3).toUpperCase()}`,\n              caseId: selectedCaseId,\n              caseName: chosenCase ? chosenCase.title : 'Operation Phantom Web',\n              title: title || 'Encrypted Voice Session Intercept Node',\n              type: evidenceType,\n              classification: classification,\n              dateCollected: new Date().toISOString().replace('T', ' ').slice(0, 16) + ' UTC',\n              collectedBy: custodyOfficer,\n              badgeNumber: badgeNumber,\n              location: location,\n              hashSHA256: mockHash,\n              aiSummary: 'AI Extraction identified 3 distinct voiceprints matching known syndicate associates. Mentions of maritime coordinates and offshore account routing verified.',\n              aiExtractionTags: ['Voiceprint Match 96.1%', 'Offshore Wire Routing', 'Constanta Node'],\n              linkedEntityIds: ['ent-1', 'ent-2'],\n              fileDetails: {\n                filename: selectedFile ? selectedFile.name : 'RAW-INTERCEPT-PAYLOAD.bin',\n                size: '18.4 MB',\n                format: 'Encrypted Stream (AES-256)'\n              }\n            }\n\n            setEvidenceList([newEv, ...evidenceList])\n            setIsProcessing(false)\n            setPipelineStep(0)\n            setSelectedFile(null)\n            setTitle('')\n          }, 600)\n        }, 600)\n      }, 600)\n    }, 600)\n  }\n\n  return (\n    <div className=\"space-y-6 font-mono\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-4\">\n        <div>\n          <div className=\"flex items-center space-x-2\">\n            <UploadCloud className=\"h-6 w-6 text-cyan-400\" />\n            <h1 className=\"text-xl md:text-2xl font-black tracking-tight text-slate-100\">\n              SECURE EVIDENCE INGESTION VAULT\n            </h1>\n          </div>\n          <p className=\"text-xs text-slate-400 mt-1\">\n            Automated cryptographic hashing, optical recognition (OCR), neural entity extraction & chain of custody\n          </p>\n        </div>\n\n        <div className=\"flex items-center space-x-2\">\n          <Badge variant=\"emerald\">FIPS 140-3 COMPLIANT</Badge>\n          <Badge variant=\"cyan\">AUTO-OCR ACTIVE</Badge>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {/* Left 2 Cols: Ingestion & Metadata Form */}\n        <div className=\"lg:col-span-2 space-y-4\">\n          <Card className=\"bg-[#0c121e] border-slate-800\">\n            <CardHeader className=\"p-4 border-b border-slate-800\">\n              <CardTitle>Evidence Ingestion & Chain of Custody Protocol</CardTitle>\n            </CardHeader>\n            <CardContent className=\"p-4\">\n              <form onSubmit={handleProcessUpload} className=\"space-y-4 text-xs\">\n                {/* Drag and drop upload zone */}\n                <div className=\"border-2 border-dashed border-slate-700 hover:border-cyan-500/70 rounded-sm p-6 text-center transition-colors bg-slate-900/40 cursor-pointer\">\n                  <UploadCloud className=\"h-10 w-10 mx-auto text-cyan-400 mb-2\" />\n                  <div className=\"text-slate-200 font-bold\">\n                    {selectedFile ? selectedFile.name : 'Drop raw intercept files or digital evidence packages here'}\n                  </div>\n                  <p className=\"text-[11px] text-slate-400 mt-1\">\n                    Supports CDR logs (.csv/.parquet), Audio intercepts (.wav/.aac), ANPR imagery, ISO SWIFT XML, PDFs\n                  </p>\n                  \n                  {/* Quick Preset Buttons */}\n                  <div className=\"mt-3 flex flex-wrap items-center justify-center gap-1.5 pt-2 border-t border-slate-800/80\">\n                    <span className=\"text-[10px] text-slate-400 mr-2\">Or load simulated feed:</span>\n                    <button\n                      type=\"button\"\n                      onClick={() => handleSimulateFileSelect('SIGINT_RAMOS_BURST_2026.wav', 'wiretap')}\n                      className=\"px-2 py-0.5 rounded-xs bg-slate-800 hover:bg-slate-700 text-cyan-300 text-[10px]\"\n                    >\n                      Audio Intercept (.wav)\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() => handleSimulateFileSelect('FINCEN_SWIFT_MT103_VALLETTA.xml', 'financial')}\n                      className=\"px-2 py-0.5 rounded-xs bg-slate-800 hover:bg-slate-700 text-emerald-300 text-[10px]\"\n                    >\n                      SWIFT Ledger (.xml)\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() => handleSimulateFileSelect('ANPR_BORDER_GIURGIU_04.h265', 'surveillance')}\n                      className=\"px-2 py-0.5 rounded-xs bg-slate-800 hover:bg-slate-700 text-amber-300 text-[10px]\"\n                    >\n                      ANPR Video (.h265)\n                    </button>\n                  </div>\n                </div>\n\n                {/* Form Fields */}\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3\">\n                  <div>\n                    <label className=\"block text-[10px] uppercase text-slate-400 font-semibold mb-1\">\n                      Assigned Investigation Case\n                    </label>\n                    <select\n                      value={selectedCaseId}\n                      onChange={(e) => setSelectedCaseId(e.target.value)}\n                      className=\"w-full h-9 rounded-sm border border-slate-700 bg-slate-900 px-3 text-xs text-slate-200\"\n                    >\n                      {mockCases.map(c => (\n                        <option key={c.id} value={c.id}>\n                          {c.caseNumber} - {c.title}\n                        </option>\n                      ))}\n                    </select>\n                  </div>\n\n                  <div>\n                    <label className=\"block text-[10px] uppercase text-slate-400 font-semibold mb-1\">\n                      Evidence Category\n                    </label>\n                    <select\n                      value={evidenceType}\n                      onChange={(e) => setEvidenceType(e.target.value as EvidenceType)}\n                      className=\"w-full h-9 rounded-sm border border-slate-700 bg-slate-900 px-3 text-xs text-slate-200\"\n                    >\n                      <option value=\"wiretap\">Audio / Wiretap (SIGINT)</option>\n                      <option value=\"financial\">Financial Wire / Ledger</option>\n                      <option value=\"cdr\">Call Detail Record (CDR)</option>\n                      <option value=\"surveillance\">Video / ANPR Surveillance</option>\n                      <option value=\"forensics\">Physical Forensics Image</option>\n                      <option value=\"document\">Classified Document / Dossier</option>\n                    </select>\n                  </div>\n\n                  <div>\n                    <label className=\"block text-[10px] uppercase text-slate-400 font-semibold mb-1\">\n                      Security Classification\n                    </label>\n                    <select\n                      value={classification}\n                      onChange={(e) => setClassification(e.target.value as ClassificationLevel)}\n                      className=\"w-full h-9 rounded-sm border border-slate-700 bg-slate-900 px-3 text-xs text-slate-200\"\n                    >\n                      <option value=\"TOP SECRET // SI\">TOP SECRET // SI</option>\n                      <option value=\"SECRET // NOFORN\">SECRET // NOFORN</option>\n                      <option value=\"CONFIDENTIAL\">CONFIDENTIAL</option>\n                      <option value=\"LAW ENFORCEMENT SENSITIVE\">LAW ENFORCEMENT SENSITIVE</option>\n                    </select>\n                  </div>\n\n                  <div>\n                    <label className=\"block text-[10px] uppercase text-slate-400 font-semibold mb-1\">\n                      Evidence Title / Descriptor\n                    </label>\n                    <Input\n                      value={title}\n                      onChange={(e) => setTitle(e.target.value)}\n                      placeholder=\"e.g. Encrypted VoLTE intercept Limassol trunk\"\n                      required\n                      className=\"bg-slate-900 border-slate-700\"\n                    />\n                  </div>\n\n                  <div>\n                    <label className=\"block text-[10px] uppercase text-slate-400 font-semibold mb-1\">\n                      Custodial Officer & Badge ID\n                    </label>\n                    <div className=\"grid grid-cols-2 gap-2\">\n                      <Input\n                        value={custodyOfficer}\n                        onChange={(e) => setCustodyOfficer(e.target.value)}\n                        placeholder=\"Officer Name\"\n                        className=\"bg-slate-900 border-slate-700\"\n                      />\n                      <Input\n                        value={badgeNumber}\n                        onChange={(e) => setBadgeNumber(e.target.value)}\n                        placeholder=\"Badge #\"\n                        className=\"bg-slate-900 border-slate-700\"\n                      />\n                    </div>\n                  </div>\n\n                  <div>\n                    <label className=\"block text-[10px] uppercase text-slate-400 font-semibold mb-1\">\n                      Collection Site Coordinates / Location\n                    </label>\n                    <Input\n                      value={location}\n                      onChange={(e) => setLocation(e.target.value)}\n                      placeholder=\"e.g. Port of Constanta Node 12\"\n                      className=\"bg-slate-900 border-slate-700\"\n                    />\n                  </div>\n                </div>\n\n                <div className=\"pt-2\">\n                  <Button\n                    type=\"submit\"\n                    variant=\"cyan\"\n                    disabled={isProcessing}\n                    className=\"w-full h-10 text-xs font-bold flex items-center justify-center space-x-2\"\n                  >\n                    {isProcessing ? (\n                      <>\n                        <RefreshCw className=\"h-4 w-4 animate-spin\" />\n                        <span>PROCESSING THROUGH AI NEURAL PIPELINE...</span>\n                      </>\n                    ) : (\n                      <>\n                        <ShieldCheck className=\"h-4 w-4\" />\n                        <span>INGEST & EXECUTE AI EXTRACTION PIPELINE</span>\n                      </>\n                    )}\n                  </Button>\n                </div>\n              </form>\n            </CardContent>\n          </Card>\n        </div>\n\n        {/* Right 1 Col: AI Pipeline Live Status Monitor */}\n        <div className=\"space-y-4\">\n          <Card className=\"bg-[#0c121e] border-slate-800\">\n            <CardHeader className=\"p-4 border-b border-slate-800\">\n              <div className=\"flex items-center justify-between\">\n                <CardTitle>AI Pipeline Telemetry</CardTitle>\n                <Cpu className=\"h-4 w-4 text-cyan-400\" />\n              </div>\n            </CardHeader>\n            <CardContent className=\"p-4 space-y-3 text-xs\">\n              {/* Step 1 */}\n              <div className={cn(\n                'p-2.5 rounded-xs border transition-colors',\n                pipelineStep >= 1 ? 'border-cyan-500/60 bg-cyan-950/30 text-cyan-200' : 'border-slate-800 bg-slate-900/30 text-slate-400'\n              )}>\n                <div className=\"flex items-center justify-between font-bold\">\n                  <span className=\"flex items-center gap-1.5\">\n                    <Hash className=\"h-3.5 w-3.5\" />\n                    1. SHA-256 Hash Verification\n                  </span>\n                  {pipelineStep >= 1 && <CheckCircle2 className=\"h-3.5 w-3.5 text-emerald-400\" />}\n                </div>\n                <div className=\"text-[10px] text-slate-400 mt-0.5\">\n                  Generate immutable checksum for Title 18 evidence compliance\n                </div>\n              </div>\n\n              {/* Step 2 */}\n              <div className={cn(\n                'p-2.5 rounded-xs border transition-colors',\n                pipelineStep >= 2 ? 'border-cyan-500/60 bg-cyan-950/30 text-cyan-200' : 'border-slate-800 bg-slate-900/30 text-slate-400'\n              )}>\n                <div className=\"flex items-center justify-between font-bold\">\n                  <span className=\"flex items-center gap-1.5\">\n                    <Cpu className=\"h-3.5 w-3.5\" />\n                    2. Named Entity Recognition (NER)\n                  </span>\n                  {pipelineStep >= 2 && <CheckCircle2 className=\"h-3.5 w-3.5 text-emerald-400\" />}\n                </div>\n                <div className=\"text-[10px] text-slate-400 mt-0.5\">\n                  LLM extraction of suspects, aliases, accounts & shell entities\n                </div>\n              </div>\n\n              {/* Step 3 */}\n              <div className={cn(\n                'p-2.5 rounded-xs border transition-colors',\n                pipelineStep >= 3 ? 'border-cyan-500/60 bg-cyan-950/30 text-cyan-200' : 'border-slate-800 bg-slate-900/30 text-slate-400'\n              )}>\n                <div className=\"flex items-center justify-between font-bold\">\n                  <span className=\"flex items-center gap-1.5\">\n                    <Fingerprint className=\"h-3.5 w-3.5\" />\n                    3. Biometric / Voiceprint Match\n                  </span>\n                  {pipelineStep >= 3 && <CheckCircle2 className=\"h-3.5 w-3.5 text-emerald-400\" />}\n                </div>\n                <div className=\"text-[10px] text-slate-400 mt-0.5\">\n                  Vector similarity comparison against international HVT registry\n                </div>\n              </div>\n\n              {/* Step 4 */}\n              <div className={cn(\n                'p-2.5 rounded-xs border transition-colors',\n                pipelineStep >= 4 ? 'border-emerald-500/60 bg-emerald-950/30 text-emerald-200' : 'border-slate-800 bg-slate-900/30 text-slate-400'\n              )}>\n                <div className=\"flex items-center justify-between font-bold\">\n                  <span className=\"flex items-center gap-1.5\">\n                    <Database className=\"h-3.5 w-3.5\" />\n                    4. Topology Graph Vectorization\n                  </span>\n                  {pipelineStep >= 4 && <CheckCircle2 className=\"h-3.5 w-3.5 text-emerald-400\" />}\n                </div>\n                <div className=\"text-[10px] text-slate-400 mt-0.5\">\n                  Autonomous edge creation and threat score recalculation\n                </div>\n              </div>\n            </CardContent>\n          </Card>\n        </div>\n      </div>\n\n      {/* Ingested Evidence Repository Section */}\n      <div className=\"space-y-3 pt-2\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center space-x-2\">\n            <FileCheck className=\"h-5 w-5 text-cyan-400\" />\n            <h2 className=\"text-sm font-bold tracking-wider uppercase text-slate-200\">\n              Verified Chain-of-Custody Archive ({evidenceList.length})\n            </h2>\n          </div>\n          <Badge variant=\"cyan\">AUTO-INDEXED</Badge>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n          {evidenceList.map((ev) => (\n            <EvidenceCard key={ev.id} evidence={ev} />\n          ))}\n        </div>\n      </div>\n    </div>\n  )\n}\n","Description":"Create UploadEvidencePage with ingestion vault, multi-format presets, hashing pipeline, and evidence archive","Overwrite":true,"TargetFile":"C:\\Users\\Nityam Jaiswal\\.gemini\\antigravity\\scratch\\nexus\\src\\pages\\UploadEvidencePage.tsx","toolAction":"Creating pages/UploadEvidencePage.tsx","toolSummary":"Create UploadEvidencePage component"}}]}
