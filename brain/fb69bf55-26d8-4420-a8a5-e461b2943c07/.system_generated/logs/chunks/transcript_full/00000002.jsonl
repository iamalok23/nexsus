 block\">Collection Location:</span>\n                <span className=\"text-slate-200\">{evidence.location}</span>\n              </div>\n              <div>\n                <span className=\"text-slate-400 block\">Chain of Custody Badge:</span>\n                <span className=\"text-emerald-400 font-bold\">{evidence.badgeNumber}</span>\n              </div>\n            </div>\n            <div>\n              <span className=\"text-[10px] text-slate-400 uppercase block mb-1\">SHA-256 Checksum</span>\n              <div className=\"p-2 bg-slate-900 rounded border border-slate-800 text-[10px] text-emerald-400 break-all select-all\">\n                {evidence.hashSHA256}\n              </div>\n            </div>\n          </div>\n        </DialogContent>\n      </Dialog>\n    </>\n  )\n}\n","Description":"Create EvidenceCard component with file metadata and cryptographic verification modal","Overwrite":true,"TargetFile":"C:\\Users\\Nityam Jaiswal\\.gemini\\antigravity\\scratch\\nexus\\src\\components\\common\\EvidenceCard.tsx","toolAction":"Creating common/EvidenceCard.tsx","toolSummary":"Create EvidenceCard component"}}]}
