{"step_index":91,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-07T10:39:30Z","thinking":"**Designing Dashboard Component Structure**\n\nNeed to structure `DashboardPage.tsx`. Planning a Command Center overview with four MetricCards: Active HVTs, Tracked Illicit Flow, Live Intercept Feeds, and AI Threat Index. Additionally, adding a Live Threat Alerts Feed using AlertCard components. Also, include an Active Cases Table with DataTable displaying status, lead investigator, priority, and actions.\n\nConsidered an Interactive Mini Network Topology Radar (preview of the graph) with pivot to `/network` and a Real-time Intercept Triage Stream. This design aims for a centralized overview.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import React, { useState } from 'react'\nimport { Link, useNavigate } from 'react-router-dom'\nimport { \n  ShieldAlert, \n  Activity, \n  Share2, \n  ArrowRight, \n  ExternalLink, \n  TrendingUp, \n  Radio, \n  Layers, \n  Eye,\n  CheckCircle2\n} from 'lucide-react'\nimport { mockMetrics, mockAlerts, mockCases, mockNetworkGraph, mockEntities } from '../data/mockData'\nimport { MetricCard } from '../components/common/MetricCard'\nimport { AlertCard } from '../components/common/AlertCard'\nimport { DataTable, Column } from '../components/common/DataTable'\nimport { NetworkGraphContainer } from '../components/network/NetworkGraphContainer'\nimport { Card, CardHeader, CardTitle, CardContent } from '../components/ui/card'\nimport { Badge } from '../components/ui/badge'\nimport { Button } from '../components/ui/button'\nimport { Case } from '../types'\n\nexport const DashboardPage: React.FC = () => {\n  const navigate = useNavigate()\n  const [alerts, setAlerts] = useState(mockAlerts)\n\n  const caseColumns: Column<Case>[] = [\n    {\n      header: 'Case ID',\n      accessorKey: 'caseNumber',\n      sortable: true,\n      cell: (row) => (\n        <span className=\"font-mono font-bold text-cyan-400\">{row.caseNumber}</span>\n      )\n    },\n    {\n      header: 'Operation Title',\n      accessorKey: 'title',\n      sortable: true,\n      cell: (row) => (\n        <div>\n          <div className=\"font-bold text-slate-100\">{row.title}</div>\n          <div className=\"text-[10px] text-slate-400 uppercase font-mono\">Codename: {row.codeName}</div>\n        </div>\n      )\n    },\n    {\n      header: 'Priority',\n      accessorKey: 'priority',\n      sortable: true,\n      cell: (row) => (\n        <Badge variant={row.priority === 'CRITICAL' ? 'critical' : row.priority === 'HIGH' ? 'high' : 'routine'}>\n          {row.priority}\n        </Badge>\n      )\n    },\n    {\n      header: 'Status',\n      accessorKey: 'status',\n      sortable: true,\n      cell: (row) => (\n        <span className=\"inline-flex items-center text-[10px] text-slate-300\">\n          <span className=\"h-1.5 w-1.5 rounded-full bg-cyan-400 mr-1.5 animate-pulse\" />\n          {row.status}\n        </span>\n      )\n    },\n    {\n      header: 'Lead Agent',\n      accessorKey: 'leadInvestigator',\n      sortable: true,\n      className: 'hidden md:table-cell'\n    },\n    {\n      header: 'Seized Assets',\n      accessorKey: 'assetsSeized',\n      sortable: true,\n      cell: (row) => (\n        <span className=\"text-emerald-400 font-semibold\">{row.assetsSeized}</span>\n      )\n    },\n    {\n      header: 'Action',\n      cell: (row) => (\n        <Link to=\"/cases\">\n          <Button variant=\"ghost\" size=\"sm\" className=\"h-6 px-2 text-cyan-400 hover:text-cyan-300\">\n            <span>Dossier</span>\n            <ArrowRight className=\"h-3 w-3 ml-1\" />\n          </Button>\n        </Link>\n      )\n    }\n  ]\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Top Welcome & Mission Status Bar */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-800 pb-4\">\n        <div>\n          <div className=\"flex items-center space-x-2\">\n            <h1 className=\"text-xl md:text-2xl font-mono font-black tracking-tight text-slate-100\">\n              INTELLIGENCE COMMAND CENTER\n            </h1>\n            <Badge variant=\"critical\" className=\"animate-pulse\">DEFCON-3</Badge>\n          </div>\n          <p className=\"text-xs font-mono text-slate-400 mt-1\">\n            Real-time multi-source data fusion & predictive syndicate tracking • Sector Eastern Europe / Med\n          </p>\n        </div>\n\n        <div className=\"flex items-center space-x-2\">\n          <Link to=\"/network\">\n            <Button variant=\"tactical\" size=\"sm\" className=\"flex items-center space-x-1.5\">\n              <Share2 className=\"h-3.5 w-3.5 text-cyan-400\" />\n              <span>Launch Graph Engine</span>\n            </Button>\n          </Link>\n          <Link to=\"/upload\">\n            <Button variant=\"cyan\" size=\"sm\">\n              <span>+ Ingest Evidence</span>\n            </Button>\n          </Link>\n        </div>\n      </div>\n\n      {/* KPI Metric Cards */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n        {mockMetrics.map((m) => (\n          <MetricCard\n            key={m.id}\n            title={m.title}\n            value={m.value}\n            change={m.change}\n            trend={m.trend}\n            threat={m.threat}\n            subtext={m.subtext}\n            sparkline={m.sparkline}\n          />\n        ))}\n      </div>\n\n      {/* Center Intelligence Workbench: Topology Radar & Live Alerts */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {/* Left 2 Cols: Network Graph Topology Canvas */}\n        <div className=\"lg:col-span-2 space-y-2\">\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center space-x-2\">\n              <span className=\"h-2 w-2 rounded-full bg-cyan-400 animate-pulse\" />\n              <h2 className=\"text-xs font-mono font-bold tracking-wider uppercase text-cyan-300\">\n                Active Syndicate Topology // Operation Phantom Web\n              </h2>\n            </div>\n            <Link to=\"/network\" className=\"text-[11px] font-mono text-cyan-400 hover:underline flex items-center\">\n              <span>Full Screen Workspace</span>\n              <ExternalLink className=\"h-3 w-3 ml-1\" />\n            </Link>\n          </div>\n\n          <NetworkGraphContainer\n            initialData={mockNetworkGraph}\n            height=\"h-[460px]\"\n          />\n        </div>\n\n        {/* Right 1 Col: Priority Threat Alerts Feed */}\n        <div className=\"space-y-3\">\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center space-x-2\">\n              <ShieldAlert className=\"h-4 w-4 text-red-400\" />\n              <h2 className=\"text-xs font-mono font-bold tracking-wider uppercase text-slate-200\">\n                Priority Intercept Stream ({alerts.length})\n              </h2>\n            </div>\n            <Badge variant=\"critical\">LIVE STREAM</Badge>\n          </div>\n\n          <div className=\"space-y-3 max-h-[460px] overflow-y-auto pr-1\">\n            {alerts.map((alert) => (\n              <AlertCard\n                key={alert.id}\n                alert={alert}\n                onDismiss={(id) => setAlerts(prev => prev.filter(a => a.id !== id))}\n              />\n            ))}\n          </div>\n        </div>\n      </div>\n\n      {/* Active Investigations Table Section */}\n      <Card className=\"bg-[#0c121e]\">\n        <CardHeader className=\"p-4 border-b border-slate-800\">\n          <div className=\"flex items-center justify-between\">\n            <div>\n              <CardTitle>Active Multi-Jurisdictional Investigations</CardTitle>\n              <p className=\"text-[11px] text-slate-400 font-mono mt-0.5\">\n                Current operations under active federal surveillance or grand jury proceedings\n              </p>\n            </div>\n            <Link to=\"/cases\">\n              <Button variant=\"outline\" size=\"sm\" className=\"h-7 text-[10px]\">\n                View All Cases\n              </Button>\n            </Link>\n          </div>\n        </CardHeader>\n        <CardContent className=\"p-4\">\n          <DataTable\n            data={mockCases}\n            columns={caseColumns}\n            searchPlaceholder=\"Search cases, investigators, jurisdictions...\"\n            searchKey=\"title\"\n            pageSize={4}\n            onRowClick={() => navigate('/cases')}\n          />\n        </CardContent>\n      </Card>\n    </div>\n  )\n}\n","Description":"Create DashboardPage with KPI metrics, interactive topology radar, alert feed, and cases table","Overwrite":true,"TargetFile":"C:\\Users\\Nityam Jaiswal\\.gemini\\antigravity\\scratch\\nexus\\src\\pages\\DashboardPage.tsx","toolAction":"Creating pages/DashboardPage.tsx","toolSummary":"Create DashboardPage component"}}]}
