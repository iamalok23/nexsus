ragStart, setDragStart] = useState({ x: 0, y: 0 })\n47: \n48:   // Selection & Hover\n49:   const [selectedNode, setSelectedNode] = useState<GraphNode | null>(null)\n50:   const [hoveredNode, setHoveredNode] = useState<\n<truncated 122 bytes>\ntedTypes, setSelectedTypes] = useState<EntityType[]>([\n55:     'suspect', 'shell_company', 'burner_phone', 'bank_account', 'safehouse', 'vehicle', 'organization'\n56:   ])\n57:   const [showOnlySuspiciousEdges, setShowOnlySuspiciousEdges] = useState(false)\n58:   const [showFilterDrawer, setShowFilterDrawer] = useState(false)\n59: \n60:   // Filtered Nodes and Edges\n61:   const filteredNodes = useMemo(() => {\n62:     return initialData.nodes.filter(\n63:       (node) => node.riskScore >= minRiskScore && selectedTypes.includes(node.type)\n64:     )\n65:   }, [initialData.nodes, minRiskScore, selectedTypes])\n66: \n67:   const filteredNodeIds = useMemo(() => new Set(filteredNodes.map(n => n.id)), [filteredNodes])\n68: \n69:   const filteredEdges = useMemo(() => {\n70:     return initialData.edges.filter((edge) => {\n71:       const hasBothNodes = filteredNodeIds.has(edge.source) && filteredNodeIds.has(edge.target)\n72:       if (!hasBothNodes) return false\n73:       if (showOnlySuspiciousEdges && !edge.isSuspicious) return false\n74:       return true\n75:     })\n76:   }, [initialData.edges, filteredNodeIds, showOnlySuspiciousEdges])\n77: \n78:   // Mouse wheel zoom\n79:   const handleWheel = (e: React.WheelEvent) => {\n80:     e.preventDefault()\n81:     const zoomFactor = e.deltaY < 0 ? 1.1 : 0.9\n82:     setZoom((prev) => Math.min(Math.max(prev * zoomFactor, 0.4), 2.5))\n83:   }\n84: \n85:   // Pan handlers\n86:   const handleMouseDown = (e: React.MouseEvent) => {\n87:     if (e.button !== 0) return // Only primary button\n88:     setIsDraggingCanvas(true)\n89:     setDragStart({ x: e.clientX - pan.x, y: e.clientY - pan.y })\n90:   }\n91: \n92:   const handleMouseMove = (e: React.MouseEvent) => {\n93:     if (isDraggingCanvas) {\n94:       setPan({\n95:         x: e.clientX - dragStart.x,\n96:         y: e.clientY - dragStart.y,\n97:       })\n98:     }\n99:   }\n100: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n","truncated_fields":["content"]}
