ems-center justify-between\\\">\\n          <div className=\\\"flex items-center space-x-2\\\">\\n            <div className=\\\"flex items-center space-x-1.5 text-[10px] font-bold text-slate-300 uppercase\\\">\\n              {getSourceIcon()}\\n              <span>{alert.source}</span>\\n            </div>\\n  \n<truncated 2991 bytes>","Description":"\"Update AlertCard to support Indian law enforcement sources and city tags\"","Overwrite":"true","TargetFile":"\"C:\\\\Users\\\\Nityam Jaiswal\\\\.gemini\\\\antigravity\\\\scratch\\\\nexus\\\\src\\\\components\\\\common\\\\AlertCard.tsx\"","toolAction":"\"Updating common/AlertCard.tsx\"","toolSummary":"\"Update AlertCard component\""}}],"truncated_fields":["tool_calls"]}
