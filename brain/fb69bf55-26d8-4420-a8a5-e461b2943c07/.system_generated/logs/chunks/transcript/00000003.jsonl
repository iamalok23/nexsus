 || {\\n        id: peerId,\\n        name: edge.label,\\n        type: 'suspect',\\n        riskScore: 75,\\n        role: 'Affiliated Contact',\\n        city: person.city,\\n        status: 'Monitored'\\n      }\\n    }\\n  })\\n\\n  // Linked evidence items\\n  const linkedEvidence = mockEvidence.filter(ev => ev.linkedEntityIds.includes(person.id))\\n\\n  return (\\n    <div className=\\\"space-y-6 font-mono\\\">\\n      {/* Target Quick Switcher Strip */}\\n      <div className=\\\"flex items-center space-x-2 overflow-x-auto pb-1 border-b border-slate-800\\\">\\n        <span className=\\\"text-[10px] uppercase text-slate-400 font-semibold shrink-0\\\">Switch Suspect:</span>\\n        {m\n<truncated 15398 bytes>","Description":"\"Update Person Details page with Indian names, cities, phone numbers, and INR financial ledger\"","Overwrite":"true","TargetFile":"\"C:\\\\Users\\\\Nityam Jaiswal\\\\.gemini\\\\antigravity\\\\scratch\\\\nexus\\\\src\\\\pages\\\\EntityProfilePage.tsx\"","toolAction":"\"Updating pages/EntityProfilePage.tsx\"","toolSummary":"\"Update Person Details component\""}}],"truncated_fields":["tool_calls"]}
