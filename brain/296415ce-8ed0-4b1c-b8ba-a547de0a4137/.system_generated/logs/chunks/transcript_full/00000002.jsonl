3:     ),\n34:     version=settings.VERSION,\n35:     docs_url=\"/docs\",\n36:     redoc_url=\"/redoc\",\n37:     openapi_url=\"/openapi.json\",\n38:     lifespan=lifespan\n39: )\n40: \n41: # 1. Enable CORS for React frontend\n42: app.add_middleware(\n43:     CORSMiddleware,\n44:     allow_origins=settings.cors_origins_list,\n45:     allow_credentials=True,\n46:     allow_methods=[\"*\"],\n47:     allow_headers=[\"*\"],\n48: )\n49: \n50: # 2. Register Centralized Error Handlers\n51: register_error_handlers(app)\n52: \n53: # 3. Mount Routers\n54: # /health directly accessible as requested: GET /health\n55: app.include_router(health_router)\n56: \n57: # /api/* endpoints\n58: app.include_router(api_router)\n59: \n60: \n61: @app.get(\"/\", include_in_schema=False)\n62: async def root():\n63:     return {\n64:         \"service\": settings.PROJECT_NAME,\n65:         \"version\": settings.VERSION,\n66:         \"status\": \"online\",\n67:         \"documentation\": \"/docs\",\n68:         \"health\": \"/health\",\n69:         \"dataset\": settings.DATASET_LABEL\n70:     }\n71: \nThe above content shows the entire, complete file contents of the requested file.\n"}
