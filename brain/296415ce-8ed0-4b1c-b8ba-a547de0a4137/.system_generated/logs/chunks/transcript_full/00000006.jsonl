ion, setNewCaseDescription] = useState('')\n\n  // Filtered cases\n  const filteredCases = cases.filter((c) => {\n    if (statusFilter !== 'ALL' && c.status !== statusFilter) return false\n    if (priorityFilter !== 'ALL' && c.priority !== priorityFilter) return false\n    if (searchQuery.trim()) {\n      const q = searchQuery.toLowerCase()\n      return (\n        c.caseNumber.toLowerCase().includes(q) ||\n        c.title.toLowerCase().includes(q) ||\n        c.codeName.toLowerCase().includes(q) ||\n        c.leadInvestigator.toLowerCase().includes(q)\n      )\n    }\n    return true\n  })\n\n  const handleCreateCase = (e: React.FormEvent) => {\n    e.preventDefault()\n    const newCase: Case = {\n      id: `case-${Date.now()}`,\n      caseNumber: `CASE-2026-${Math.floor(1000 + Math.random() * 9000)}`,\n      title: newCaseTitle || 'Operation Shadow Ledger',\n      codeName: (newCaseCodename || 'SHADOW LEDGER').toUpperCase(),\n      description: newCaseDescription || 'Investigating darknet transaction routing and front shell logistics.',\n      status: 'Active Investigation',\n      priority: newCasePriority,\n      leadInvestigator: newCaseLead,\n      agency: 'Federal Organized Crime Taskforce',\n      jurisdiction: newCaseJurisdiction,\n      openedDate: new Date().toISOString().split('T')[0],\n      lastUpdated: new Date().toISOString(),\n      warrantsIssued: 2,\n      assetsSeized: '$0',\n      entitiesCount: 4,\n      evidenceCount: 12,\n      riskIndex: 78\n    }\n\n    setCases([newCase, ...cases])\n    setIsCreateModalOpen(false)\n    setNewCaseTitle('')\n    setNewCaseCodename('')\n    setNewCaseDescription('')\n  }\n\n  return (\n    <div className=\"space-y-6 font-mono\">\n      {/* Header */}","TargetFile":"C:\\Users\\Nityam Jaiswal\\.gemini\\antigravity\\scratch\\nexus\\src\\pages\\CasesPage.tsx","toolAction":"Updating CasesPage.tsx","toolSummary":"Update CasesPage.tsx with api & banner"}}]}
