{"step_index":520,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-09T10:40:15Z","content":"Created At: 2026-09-09T16:10:15+05:30\nCompleted At: 2026-09-09T16:10:15+05:30\nFile Path: `file:///C:/Users/Nityam%20Jaiswal/.gemini/antigravity/scratch/nexus/src/lib/api.ts`\nTotal Lines: 137\nTotal Bytes: 3951\nShowing lines 1 to 60\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: /**\r\n2:  * Central API Client for NEXUS Backend\r\n3:  * Base URL: http://localhost:8000\r\n4:  */\r\n5: import { Case, Entity, NetworkGraphData, CrimePattern, ThreatAlert, MetricData } from '../types'\r\n6: \r\n7: export const API_BASE_URL = import.meta.env.VITE_API_BASE_URL || 'http://localhost:8000'\r\n8: \r\n9: export interface CaseInsightsResponse {\r\n10:   caseId: string\r\n11:   caseTitle: string\r\n12:   summary: string\r\n13:   patterns: CrimePattern[]\r\n14:   alerts: ThreatAlert[]\r\n15:   metrics: MetricData[]\r\n16:   dataset_label: string\r\n17: }\r\n18: \r\n19: export interface HealthResponse {\r\n20:   status: string\r\n21:   service: string\r\n22:   version: string\r\n23:   timestamp: string\r\n24:   dataset: string\r\n25:   active_cases: number\r\n26: }\r\n27: \r\n28: export class ApiError extends Error {\r\n29:   status: number\r\n30:   details?: unknown\r\n31: \r\n32:   constructor(message: string, status: number, details?: unknown) {\r\n33:     super(message)\r\n34:     this.name = 'ApiError'\r\n35:     this.status = status\r\n36:     this.details = details\r\n37:   }\r\n38: }\r\n39: \r\n40: async function request<T>(endpoint: string, options: RequestInit = {}): Promise<T> {\r\n41:   const url = `${API_BASE_URL}${endpoint}`\r\n42:   const headers = {\r\n43:     'Content-Type': 'application/json',\r\n44:     ...(options.headers || {}),\r\n45:   }\r\n46: \r\n47:   try {\r\n48:     const response = await fetch(url, {\r\n49:       ...options,\r\n50:       headers,\r\n51:     })\r\n52: \r\n53:     if (!response.ok) {\r\n54:       let errorDetail = ''\r\n55:       try {\r\n56:         const errorJson = await response.json()\r\n57:         errorDetail = errorJson.error?.message || errorJson.detail || JSON.stringify(errorJson)\r\n58:       } catch {\r\n59:         errorDetail = response.statusText\r\n60:       }\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
