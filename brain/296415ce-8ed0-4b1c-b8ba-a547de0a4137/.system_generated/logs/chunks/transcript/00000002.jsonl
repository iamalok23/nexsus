{"step_index":179,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-07T20:41:14Z","content":"Created At: 2026-09-08T02:11:14+05:30\nCompleted At: 2026-09-08T02:11:14+05:30\nFile Path: `file:///C:/Users/Nityam%20Jaiswal/.gemini/antigravity/scratch/backend/app/main.py`\nTotal Lines: 71\nTotal Bytes: 2092\nShowing lines 1 to 71\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"NEXUS Backend Application Entrypoint.\n2: \n3: FastAPI backend for law enforcement intelligence analysis prototype.\n4: Configured with CORS for React frontend, centralized error handling,\n5: NetworkX graph analysis, and OpenAPI docs.\n6: \"\"\"\n7: from contextlib import asynccontextmanager\n8: from fastapi import FastAPI\n9: from fastapi.middleware.cors import CORSMiddleware\n10: \n11: from app.utils.config import settings\n12: from app.utils.database import Base, engine\n13: from app.utils.errors import register_error_handlers\n14: from app.api.router import api_router\n15: from app.api.health import router as health_router\n16: \n17: \n18: @asynccontextmanager\n19: async def lifespan(app: FastAPI):\n20:     \"\"\"Application lifespan context: initialize SQLite tables on startup.\"\"\"\n21:     Base.metadata.create_all(bind=engine)\n22:     yield\n23: \n24: \n25: app = FastAPI(\n26:     title=settings.PROJECT_NAME,\n27:     description=(\n28:         \"## NEXUS Intelligence & Investigation Analysis Platform API\\n\\n\"\n29:         \"**Ethical Prototype Notice**:\\n\"\n30:         \"- Uses purely synthetic Indian investigation data ('Operation Chakravyuh').\\n\"\n31:         \"- Graph construction and topological metrics powered by **NetworkX**.\\n\"\n32:         \"- All analytical findings and pattern detections are risk indicators requiring human analyst review.\\n\"\n33:     ),\n34:     version=settings.VERSION,\n35:     docs_url=\"/docs\",\n36:     redoc_url=\"/redoc\",\n37:     openapi_url=\"/openapi.json\",\n38:     lifespan=lifespan\n39: )\n40: \n41: # 1. Enable CORS for React frontend\n42: app.add_middleware(\n43:     CORSMiddleware,\n44:     allow_origins=settings.cors_origins_list,\n45:     allow_credentials=True,\n46:     allow_methods=[\"*\"],\n47:     allow_headers=[\"*\"],\n48: )\n49: \n50: # 2. Register Centralized Error Handlers\n51: register_error_handlers(app)\n52: \n53: # 3. Mount Routers\n54: # /health directly accessible as requested: GET /health\n55: app.include_router(health_router)\n56: \n57: # /api/* endpoints\n58: app.include_router(api_router)\n59: \n60: \n61: @app.get(\"/\", include_in_schema=False)\n62: async def root():\n63:     return {\n64:         \"service\": settings.PROJECT_NAME,\n65:         \"version\": settings.VERSION,\n66:         \"status\": \"online\",\n67:         \"documentation\": \"/docs\",\n68:         \"health\": \"/health\",\n69:         \"dataset\": settings.DATASET_LABEL\n70:     }\n71: \nThe above content shows the entire, complete file contents of the requested file.\n"}
