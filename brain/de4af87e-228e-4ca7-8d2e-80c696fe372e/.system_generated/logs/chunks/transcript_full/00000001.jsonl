n283: def _compute_hash(entry: dict[str, Any]) -> str:\n284:     \"\"\"\n285:     Compute deterministic SHA-256 hash of an entry based on all its fields\n286:     excluding 'entry_hash'.\n287:     \"\"\"\n288:     hashable_data = {k: v for k, v in entry.items() if k != \"entry_hash\"}\n289:     canonical = json.dumps(hashable_data, sort_keys=True, separators=(\",\", \":\"))\n290:     return hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()\n291: \n292: \n293: def audit(\n294:     principal: Principal | dict[str, Any] | None,\n295:     action: str,\n296:     detail: dict[str, Any],\n297:     log_path: Path | str | None = None,\n298: ) -> dict[str, Any]:\n299:     \"\"\"\n300:     Write a tamper-evident, cryptographically chained audit log entry.\n301:     Thread-safe write guarded by threading.Lock().\n302:     The detail dictionary is encrypted using _encrypt.\n303:     \"\"\"\n304:     target_path = Path(log_path) if log_path else AUDIT_LOG_FILE\n305: \n306:     # Normalize user details\n307:     if isinstance(principal, Principal):\n308:         user_info = principal.to_dict()\n309:     elif isinstance(principal, dict):\n310:         user_info = {\n311:             \"name\": str(principal.get(\"name\", \"Unknown\")),\n312:             \"role\": str(principal.get(\"role\", \"unknown\")),\n313:             \"unit\": str(principal.get(\"unit\", \"unknown\")),\n314:             \"badge\": str(principal.get(\"badge\", \"N/A\")),\n315:         }\n316:     else:\n317:         user_info = {\n318:             \"name\": \"SYSTEM\",\n319:             \"role\": \"system\",\n320:             \"unit\": \"KERNEL\",\n321:             \"badge\": \"SYS-0000\",\n322:         }\n323: \n324:     # Encrypt the detail payload\n325:     encrypted_payload = _encrypt(detail)\n326: \n327:     with _LOG_LOCK:\n328:         # Determine current sequence number and prev_hash\n329:         prev_hash = GENESIS_PREV_HASH\n330:         next_seq = 1\n331: \n332:         if target_path.exists()