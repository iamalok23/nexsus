graph:read\",\n49: }\n50: \n51: ROLES: dict[str, set[str]] = {\n52:     \"investigator\": INVESTIGATOR_PERMS,\n53:     \"supervisor\": SUPERVISOR_PERMS,\n54:     \"admin\": ADMIN_PERMS,\n55:     \"viewer\": VIEWER_PERMS,\n56: }\n57: \n58: USERS: dict[str, dict[str, str]] = {\n59:     \"demo-investigator\": {\n60:         \"name\": \"Det. Sarah Miller\",\n61:         \"role\": \"investigator\",\n62:         \"unit\": \"Major Narcotics Task Force\",\n63:         \"badge\": \"BADGE-7402\",\n64:     },\n65:     \"demo-supervisor\": {\n66:         \"name\": \"Lt. Marcus Vance\",\n67:         \"role\": \"supervisor\",\n68:         \"unit\": \"Special Investigations Division\",\n69:         \"badge\": \"BADGE-3319\",\n70:     },\n71:     \"demo-admin\": {\n72:         \"name\": \"Chief Elena Rostova\",\n73:         \"role\": \"admin\",\n74:         \"unit\": \"Intelligence & Cyber Operations\",\n75:         \"badge\": \"BADGE-1001\",\n76:     },\n77:     \"demo-viewer\": {\n78:         \"name\": \"Analyst David Park\",\n79:         \"role\": \"viewer\",\n80:         \"unit\": \"Criminal Intelligence Bureau\",\n81:         \"badge\": \"BADGE-9082\",\n82:     },\n83: }\n84: \n85: \n86: @dataclass(frozen=True)\n87: class Principal:\n88:     name: str\n89:     role: str\n90:     unit: str\n91:     badge: str\n92:     token: str | None = None\n93: \n94:     def can(self, permission: str) -> bool:\n95:         \"\"\"Check whether the principal's role grants the requested permission.\"\"\"\n96:         role_perms = ROLES.get(self.role, set())\n97:         return permission in role_perms\n98: \n99:     def to_dict(self) -> dict[str, str]:\n100:         \"\"\"Convert principal identity details to a dictionary.\"\"\"\n101:         return {\n102:             \"name\": self.name,\n103:             \"role\": self.role,\n104:             \"unit\": self.unit,\n105:             \"badge\": self.badge,\n106:         }\n107: \n108: \n109: def current_user(x_auth_token: str = Header(..., alias=\"X-Auth-Token\")) -> Principal:\n110:     \"\"\"\n111:     FastAPI dependency to authenticate and resolve the current user Principal\n112:     from the X-Auth-Token HTTP header. Raises HTTP 401 if token is invalid or missing.\n113:     \"\"\"\n114:     if not x_auth_token or x_auth_token not in USERS:\n115:         raise HTTPException(\n116:             status_code=status.HTTP_401_UNAUTHORIZED,\n117:             detail=\"Authentication failed: invalid or unrecognized authorization token.\",\n118:             headers={\"WWW-Authenticate\": \"X-Auth-Token\"},\n119:         )\n120: \n121:     user_info = USERS[x_auth_token]\n122:     return Principal(\n123:         name=user_info[\"name\"],\n124:         role=user_info[\"role\"],\n125:         unit=user_info[\"unit\"],\n126:         badge=user_info[\"badge\"],\n127:         token=x_auth_token,\n128:     )\n129: \n130: \n131: def require(principal: Principal, permission: str) -> None:\n132:     \"\"\"\n133:     Validate that the principal has the specified permission.\n134:     If denied, an audit entry is automatically written and an HTTP 403 exception is raised.\n135:     \"\"\"\n136:     if not principal.can(permission):\n137:         # Log unauthorized access attempt in tamper-evident audit log\n138:         audit(\n139:             principal=principal,\n140:             action=\"auth:permission_denied\",\n141:             detail={\n142:                 \"attempted_permission\": permission,\n143:                 \"role\": principal.role,\n144:                 \"badge\": principal.badge,\n145:                 \"status\": \"DENIED\",\n146:                 \"reason\": f\"Role '{principal.role}' lacks permission '{permission}'\",\n147:             },\n148:         )\n149:         raise HTTPException(\n150:             status_code=status.HTTP_403_FORBIDDEN,\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool aga