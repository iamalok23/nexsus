n-property': 'background-color, border-color, border-width, width, height',\n      'transition-duration': '0.2s',\n    },\n  },\n  // 1. Person nodes: Red Circles\n  {\n    selector: 'node[type = \"person\"], node[type = \"Person\"]',\n    style: {\n      'shape': 'ellipse',\n      'background-color': '#ef4444',\n      'border-color': '#f87171',\n      'border-width': 3,\n      'shadow-blur': 12,\n      'shadow-color': '#ef4444',\n      'shadow-opacity': 0.4,\n    },\n  },\n  // 2. Phone nodes: Blue Squares\n  {\n    selector: 'node[type = \"phone\"], node[type = \"Phone\"]',\n    style: {\n      'shape': 'rectangle',\n      'background-color': '#3b82f6',\n      'border-color': '#60a5fa',\n      'border-width': 3,\n      'shadow-blur': 12,\n      'shadow-color': '#3b82f6',\n      'shadow-opacity': 0.4,\n    },\n  },\n  // 3. Account nodes: Green Triangles\n  {\n    selector: 'node[type = \"account\"], node[type = \"Account\"]',\n    style: {\n      'shape': 'triangle',\n      'background-color': '#10b981',\n      'border-color': '#34d399',\n      'border-width': 3,\n      'shadow-blur': 12,\n      'shadow-color': '#10b981',\n      'shadow-opacity': 0.4,\n    },\n  },\n  // Active / Selected Node State\n  {\n    selector: 'node:selected',\n    style: {\n      'border-width': 4,\n      'border-color': '#fbbf24',\n      'border-opacity': 1,\n      'shadow-blur': 22,\n      'shadow-color': '#fbbf24',\n      'shadow-opacity': 0.9,\n      'width': 50,\n      'height': 50,\n    },\n  },\n  // Highlighted Target Node (e.g. from Alert click)\n  {\n    selector: 'node.highlighted',\n    style: {\n      'border-width': 4,\n      'border-color': '#f59e0b',\n      'shadow-blur': 30,\n      'shadow-color': '#f59e0b',\n      'shadow-opacity': 1,\n    },\n  },\n  // Base Edge Style: Directed Arrows\n  {\n    selector: 'edge',\n    style: {\n      'width': 2,\n      'line-color': '#475569',\n      'target-arrow-shape': 'triangle',\n      'target-arrow-color': '#94a3b8',\n      'arro